{
 "$schema":"../../node_modules/wrangler/config-schema.json",
 "name":"sushant-synapse-free-staging",
 "main":"fullstack-worker.mjs",
 "compatibility_date":"2026-10-01",
 "compatibility_flags":["nodejs_compat"],
 "workers_dev":true,
 "preview_urls":false,
 "build":{"command":"node build.cjs --fullstack","cwd":"infrastructure/cloudflare"},
 "assets":{"directory":"./dist","binding":"ASSETS","html_handling":"none","not_found_handling":"none","run_worker_first":true},
 "vars":{"PUBLIC_ORIGIN":"http://127.0.0.1:8787","MAINTENANCE_MODE":"false","FREE_MODE":"true","ACCESS_TEAM_DOMAIN":"","ACCESS_AUD":""},
 "d1_databases":[{"binding":"PLATFORM_DB","database_name":"synapse-platform-free-staging","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"d1-free-migrations"}],
 "ratelimits":[
  {"name":"NEWS_LIMITER","namespace_id":"2026101104","simple":{"limit":6,"period":60}},
  {"name":"FUND_LIMITER","namespace_id":"2026101105","simple":{"limit":30,"period":60}},
  {"name":"ARENA_LIMITER","namespace_id":"2026101106","simple":{"limit":30,"period":60}}
 ],
 "observability":{"enabled":false}
}
