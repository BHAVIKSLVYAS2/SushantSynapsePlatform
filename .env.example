# Generate a random secret of at least 24 characters before starting Compose.
# Example generator: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# This token protects first-owner setup on the public website. Do not commit it.
SETUP_TOKEN=

# Leave sqlite selected until the SQL Server migration is verified.
DATABASE_PROVIDER=sqlite
# For Azure SQL, select sqlserver and supply ONE database name.
SQLSERVER_SERVER=
SQLSERVER_DATABASE=
SQLSERVER_AUTH=managed-identity
# Optional user-assigned managed identity client ID.
AZURE_CLIENT_ID=
# SQL authentication alternative; keep credentials out of source control.
SQLSERVER_USER=
SQLSERVER_PASSWORD=
# Run db:sqlserver:init with migration privileges instead of auto-migrating production.
SQLSERVER_AUTO_MIGRATE=0
# Preserve the existing Cloudflare secret at Arena cutover; rotation breaks browser ballot identities.
ARENA_COOKIE_SECRET=
