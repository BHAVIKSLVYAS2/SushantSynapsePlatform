{
  "name": "sushant-synapse-platform",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev:cloudflare:free": "wrangler dev --config infrastructure/cloudflare/wrangler.free.jsonc --local --port 8787 --var PUBLIC_ORIGIN:http://127.0.0.1:8787",
    "build:cloudflare:free": "wrangler deploy --dry-run --config infrastructure/cloudflare/wrangler.free.jsonc --outdir .publish/free-dryrun",
    "db:d1:free:local": "wrangler d1 migrations apply synapse-platform-free-staging --config infrastructure/cloudflare/wrangler.free.jsonc --local",
    "db:cloudflare:free-import": "node infrastructure/cloudflare/free-import.cjs",
    "db:cloudflare:free-recovery": "node infrastructure/cloudflare/free-recovery.cjs",
    "db:sqlserver:init": "node infrastructure/sqlserver.cjs init",
    "db:sqlserver:import": "node infrastructure/sqlserver.cjs import",
    "db:sqlserver:import-arena": "node infrastructure/sqlserver.cjs import-arena",
    "dev:cloudflare": "wrangler dev --config infrastructure/cloudflare/wrangler.fullstack.jsonc --local --port 8787",
    "build:cloudflare": "wrangler deploy --dry-run --config infrastructure/cloudflare/wrangler.fullstack.jsonc --outdir .publish/fullstack-dryrun",
    "db:d1:local": "wrangler d1 migrations apply synapse-platform-staging --config infrastructure/cloudflare/wrangler.fullstack.jsonc --local",
    "db:cloudflare:transfer": "node infrastructure/cloudflare/transfer.cjs",
    "test:cloudflare": "node infrastructure/cloudflare/test.cjs",
    "build:ui": "tailwindcss -i packages/ui/premium.tailwind.css -o packages/ui/premium.bundle.css --minify && node infrastructure/build-home.cjs",
    "build:frontend": "npm run build:ui && node infrastructure/cloudflare/build.cjs",
    "deploy:frontend:preview": "wrangler deploy --config infrastructure/cloudflare/wrangler.jsonc --env preview",
    "deploy:frontend": "wrangler deploy --config infrastructure/cloudflare/wrangler.free.production.jsonc --keep-vars",
    "start": "node server/index.js",
    "test": "node infrastructure/test.cjs",
    "test:pandit": "node --test tests/pandit-booking.test.js tests/pandit-booking-d1.test.js",
    "test:organisation-readiness": "node --test tests/organisation-*.test.js",
    "test:e2e": "playwright test",
    "test:advocate": "playwright test apps/advocate/tests",
    "test:portal": "playwright test apps/portal/tests",
    "test:news": "playwright test apps/news/tests",
    "test:fund-overlap": "playwright test apps/fund-overlap/tests",
    "refresh:funds": "python apps/fund-overlap/ingestion/refresh.py",
    "refresh:funds:national": "node apps/fund-overlap/ingestion/refresh-national.js",
    "refresh:funds:official": "python apps/fund-overlap/ingestion/official_refresh.py",
    "test:ingestion": "python -m unittest discover -s apps/fund-overlap/tests -p test_*.py"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.145.0",
    "lightningcss": "^1.32.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "mssql": "^12.7.4"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^5.5.0"
  }
}
